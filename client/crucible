#!/usr/bin/env python3
"""Command line access to the Crucible facility. Standard library only."""
import argparse
import json
import os
import sys
import urllib.error
import urllib.request

URL = os.environ.get("CRUCIBLE_URL", "http://sim:8000")


def call(cmd, **body):
    req = urllib.request.Request(f"{URL}/api/{cmd}", data=json.dumps(body).encode(),
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=120) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        try:
            msg = json.loads(e.read()).get("error", str(e))
        except Exception:
            msg = str(e)
        print(f"error: {msg}", file=sys.stderr)
        sys.exit(2)
    except urllib.error.URLError as e:
        print(f"error: cannot reach the facility at {URL}: {e.reason}", file=sys.stderr)
        sys.exit(3)


def grid(rows):
    w = len(rows[0])
    out = ["     " + "".join(str(x // 10) if x % 10 == 0 else " " for x in range(w)),
           "     " + "".join(str(x % 10) for x in range(w))]
    out += [f"{y:>3}  {r}" for y, r in enumerate(rows)]
    return "\n".join(out)


def show_reactions(rx):
    if not rx:
        print("reactions: none")
    for r in rx:
        print(f"reaction: {r['between'][0]} touched {r['between'][1]}, happened {r['contacts']} times: {r['result']}")


def show_view(v):
    print(f"chamber {v['chamber']}  [{v['status']}]  size {v['width']}x{v['height']}  (x grows right, y grows down)")
    if "grid" in v:
        print(grid(v["grid"]))
        print("legend: # wall   . empty   digit = closed gate with that number   " +
              "   ".join(f"{s['symbol']} = {s['name']}" for s in v["substances_present"]))
    print(f"closed gates: {v['gates_closed']}   opened so far, in order: {v['gates_opened_in_order']}")
    for o in v["objectives"]:
        print(f"objective {o['zone']}: {o['needs']}; zone spans x {o['x'][0]}..{o['x'][1]}, y {o['y'][0]}..{o['y'][1]}; "
              f"now {o['current_cells']} -> {'MET' if o['met'] else 'not met'}")


def main():
    ap = argparse.ArgumentParser(prog="crucible")
    ap.add_argument("--json", action="store_true", help="print the raw JSON response")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("brief", help="substances, lab budget, chambers and objectives")
    sub.add_parser("status", help="progress summary")
    p = sub.add_parser("view", help="show a chamber")
    p.add_argument("chamber", type=int)
    p = sub.add_parser("lab", help="run a lab experiment from a layout file ('-' for stdin)")
    p.add_argument("layout")
    p = sub.add_parser("open", help="open a gate in a chamber (cannot be undone)")
    p.add_argument("chamber", type=int)
    p.add_argument("gate", type=int)
    p = sub.add_parser("close", help="stop working on a chamber for good")
    p.add_argument("chamber", type=int)
    p = sub.add_parser("frames", help="tick-by-tick recording of a lab run or a gate opening")
    p.add_argument("kind", choices=["lab", "chamber"])
    p.add_argument("a", type=int, help="lab run number, or chamber number")
    p.add_argument("b", type=int, nargs="?", help="for chamber: which opening (1 = first gate opened)")
    p.add_argument("--every", type=int, default=1)
    a = ap.parse_args()

    if a.cmd == "brief":
        r = call("brief")
        if a.json:
            return print(json.dumps(r, indent=1))
        print("substances you can place in the lab:")
        for s in r["substances"]:
            print(f"  {s['symbol']} = {s['name']}")
        print(r["note"])
        lab = r["lab"]
        print(f"lab: box {lab['width']} wide x {lab['height']} high, {lab['runs_left']} of {lab['runs_total']} runs left")
        for v, wgt in zip(r["chambers"], r["scoring"]["weights"]):
            print(f"-- weight {wgt}")
            show_view(v)
    elif a.cmd == "status":
        r = call("status")
        print(json.dumps(r, indent=1) if a.json else
              f"lab runs left: {r['lab_runs_left']}\n" + "\n".join(
                  f"chamber {i + 1}: {c['objectives_met']}/{c['objectives']} objectives met, "
                  f"{'complete' if c['complete'] else 'not complete'}, gates opened {c['gates_opened']}"
                  for i, c in enumerate(r["chambers"])))
    elif a.cmd == "view":
        r = call("view", chamber=a.chamber)
        print(json.dumps(r, indent=1)) if a.json else show_view(r)
    elif a.cmd == "lab":
        text = sys.stdin.read() if a.layout == "-" else open(a.layout).read()
        rows = [ln.rstrip("\n") for ln in text.split("\n")]
        while rows and not rows[-1].strip():
            rows.pop()
        r = call("lab", rows=rows)
        if a.json:
            return print(json.dumps(r, indent=1))
        print(f"lab run {r['run']} ({r['runs_left']} left): {r['ticks']} ticks, "
              f"{'came to rest' if r['came_to_rest'] else 'still moving at the tick limit'}")
        print("start:")
        print(grid(r["start"]))
        print("end:")
        print(grid(r["end"]))
        show_reactions(r["reactions"])
        print(f"full recording: crucible frames lab {r['run']}")
    elif a.cmd == "open":
        r = call("open", chamber=a.chamber, gate=a.gate)
        if a.json:
            return print(json.dumps(r, indent=1))
        print(f"opened gate {r['opened']}: {r['ticks']} ticks, "
              f"{'came to rest' if r['came_to_rest'] else 'still moving at the tick limit'}")
        show_reactions(r["reactions"])
        show_view(r)
        print(f"full recording: crucible frames chamber {a.chamber} {len(r['gates_opened_in_order'])}")
    elif a.cmd == "close":
        r = call("close", chamber=a.chamber)
        print(json.dumps(r, indent=1)) if a.json else show_view(r)
    elif a.cmd == "frames":
        if a.kind == "lab":
            r = call("frames", kind="lab", run=a.a, every=a.every)
        else:
            if a.b is None:
                ap.error("frames chamber needs the opening number")
            r = call("frames", kind="chamber", chamber=a.a, step=a.b, every=a.every)
        if a.json:
            return print(json.dumps(r["frames"]))
        for i, f in enumerate(r["frames"]):
            print(f"-- frame {i}")
            print("\n".join(f))


if __name__ == "__main__":
    main()
